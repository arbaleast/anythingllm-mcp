# AnythingLLM MCP Server Configuration
# =========================================
#
# SECURITY WARNING: This file contains sensitive credentials.
# - Never commit this file to version control
# - Add ".env" to your .gitignore file
# - Use strong, randomly generated API keys
# - Rotate keys periodically for production environments
#
# For production deployments:
# - Use environment variables instead of .env files when possible
# - Use secrets management systems (e.g., AWS Secrets Manager, HashiCorp Vault)
# - Restrict file permissions: chmod 600 .env
#
# =========================================

# AnythingLLM API Configuration
# -----------------------------
# The URL where AnythingLLM is running
ANYTHINGLLM_API_BASE_URL=http://localhost:3001
# Alternative legacy name (for backward compatibility):
# ANYTHINGLLM_BASE_URL=http://localhost:3001

# Your AnythingLLM API key (required)
# Generate this in AnythingLLM Settings → API Keys
# SECURITY: Never expose this key in client-side code or public repositories
ANYTHINGLLM_API_KEY=replace_with_your_anythingllm_api_key

# HTTP API Gateway Authentication (optional)
# -----------------------------------------
# Required for running the HTTP gateway (server_http.py or server_sse.py)
# IMPORTANT: Use a strong, randomly generated secret (at least 32 characters)
# Example: openssl rand -hex 32
HTTP_API_KEY=replace_with_strong_secret_at_least_32_chars

# MCP Server Configuration (optional)
# ------------------------------------
# Host and port for MCP server
# MCP_SERVER_HOST=0.0.0.0
# MCP_SERVER_PORT=8765
# MCP_SERVER_URL=http://localhost:8765

# Timeout Configuration (optional)
# ---------------------------------
# Default request timeout in seconds
# DEFAULT_TIMEOUT=180.0

# Upload timeout for large files in seconds
# UPLOAD_TIMEOUT=300.0

# OAuth Configuration (optional)
# ------------------------------
# Authorization code expiry in seconds (default: 600 = 10 minutes)
# AUTH_CODE_EXPIRY=600

# Access token expiry in seconds (default: 3600 = 1 hour)
# TOKEN_EXPIRY=3600

# Debug Options (optional)
# -----------------------
# Set to 1 to enable debug endpoint on server_streamable.py
# WARNING: Do not enable in production - exposes internal information
# MCP_DEBUG=
